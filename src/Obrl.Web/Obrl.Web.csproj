<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>obrl-web</UserSecretsId>
    <!-- PDFtoImage is marked for desktop/mobile platforms only; OBRL runs on Linux, Windows and macOS, which are all supported. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Version shown in the footer as major.minor.build. Change major.minor by hand for a release, and add the
         release to Services/ReleaseNotes.cs (the version history page).
         The build number is the build time (UTC) as yyyyMMddHHmmss, shown in hexadecimal. -->
    <ObrlVersion>1.1</ObrlVersion>
    <ObrlBuildTimestamp Condition="'$(ObrlBuildTimestamp)' == ''">$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</ObrlBuildTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ObrlVersion" Value="$(ObrlVersion)" />
    <AssemblyMetadata Include="ObrlBuildTimestamp" Value="$(ObrlBuildTimestamp)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="VersOne.Epub" Version="3.3.6" />
  </ItemGroup>

</Project>
