@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.ShowRecoveryCodesModel
@{
    Layout = "/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
    ViewData["Title"] = L["Recovery codes"].Value;
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}
<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@L["Recovery codes"]</h3>
<div class="alert alert-warning" role="alert">
    <p><strong>@L["Put these codes in a safe place."]</strong></p>
    <p class="mb-0">@L["If you lose your device and don't have the recovery codes you will lose access to your account."]</p>
</div>
<div>
    @for (var row = 0; row < (Model.RecoveryCodes?.Length ?? 0); row += 2)
    {
        <code class="recovery-code">@Model.RecoveryCodes![row]</code><text>&nbsp;</text><code class="recovery-code">@Model.RecoveryCodes[row + 1]</code><br />
    }
</div>
