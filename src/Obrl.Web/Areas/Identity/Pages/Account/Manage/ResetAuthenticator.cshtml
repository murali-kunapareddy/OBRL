@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.ResetAuthenticatorModel
@{
    Layout = "/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
    ViewData["Title"] = L["Reset authenticator key"].Value;
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}
<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@L["Reset authenticator key"]</h3>
<div class="alert alert-warning" role="alert">
    <p><strong>@L["If you reset your authenticator key your authenticator app will not work until you reconfigure it."]</strong></p>
    <p class="mb-0">@L["This process disables 2FA until you verify your authenticator app. If you do not complete your authenticator app configuration you may lose access to your account."]</p>
</div>
<form id="reset-authenticator-form" method="post">
    <button id="reset-authenticator-button" class="btn btn-danger" type="submit">@L["Reset authenticator key"]</button>
</form>
