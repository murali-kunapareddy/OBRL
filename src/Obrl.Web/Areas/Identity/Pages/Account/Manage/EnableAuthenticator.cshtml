@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.EnableAuthenticatorModel
@{
    Layout = "/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
    ViewData["Title"] = L["Configure authenticator app"].Value;
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}
<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@L["Configure authenticator app"]</h3>
<p>@L["To use an authenticator app go through the following steps:"]</p>
<ol class="list">
    <li>
        <p>@L["Download a two-factor authenticator app like Microsoft Authenticator, Google Authenticator or any other TOTP app for your phone."]</p>
    </li>
    <li>
        <p>@H["Scan the QR Code or enter this key <kbd>{0}</kbd> into your two factor authenticator app. Spaces and casing do not matter.", Model.SharedKey ?? ""]</p>
        <div id="qrCode" class="mb-3" style="max-width:220px"></div>
        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
    </li>
    <li>
        <p>@L["Once you have scanned the QR code or input the key above, your two factor authentication app will provide you with a unique code. Enter the code in the confirmation box below."]</p>
        <form id="send-code" method="post" style="max-width:320px">
            <div class="mb-3">
                <label asp-for="Input.Code" class="form-label fw-semibold">@L["Verification code"]</label>
                <input asp-for="Input.Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" />
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>
            <partial name="_ErrorSummary" />
            <button type="submit" class="btn btn-primary">@L["Verify"]</button>
        </form>
    </li>
</ol>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
