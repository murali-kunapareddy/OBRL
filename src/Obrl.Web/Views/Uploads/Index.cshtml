@model List<Book>
@{
    ViewData["Title"] = "Uploads";
    var seesAll = ViewBag.SeesAll == true;
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="page-title">@(seesAll ? "All books" : "My uploads")</h1>
        <p class="page-sub">Uploads are converted in the background. Refresh to see the latest status.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-cloud-arrow-up me-1"></i> Upload a book</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-shelf">Nothing uploaded yet.</div>
}
else
{
    <div class="panel p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Title</th><th>Format</th><th>Status</th>@if (seesAll) { <th>Uploaded by</th> }<th>Added</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><a href="/books/@b.Id">@b.Title</a><div class="small text-muted">@b.Author</div></td>
                            <td>@b.OriginalFormat.ToUpperInvariant() <span class="small text-muted">· @(b.Mode == ReaderMode.Page ? "pages" : "text")</span></td>
                            <td>
                                @switch (b.Status)
                                {
                                    case BookStatus.Ready: <span class="badge text-bg-success">Ready</span> break;
                                    case BookStatus.Failed: <span class="badge text-bg-danger">Failed</span><div class="small text-danger">@b.StatusMessage</div> break;
                                    default: <span class="badge text-bg-secondary">@b.Status</span> break;
                                }
                            </td>
                            @if (seesAll) { <td class="small">@b.UploadedBy?.Email</td> }
                            <td class="small text-muted">@b.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@b.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                @if (b.Status == BookStatus.Failed)
                                {
                                    <form class="d-inline" method="post" asp-action="Retry" asp-route-id="@b.Id"><button class="btn btn-sm btn-outline-secondary" title="Try again"><i class="bi bi-arrow-clockwise"></i></button></form>
                                }
                                <form class="d-inline" method="post" asp-action="Delete" asp-route-id="@b.Id" data-confirm="Delete “@b.Title” for everyone? This cannot be undone.">
                                    <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
