@model UploadVm
@{
    var creating = Model.Id is null;
    ViewData["Title"] = creating ? L["Upload a book"].Value : L["Edit book"].Value;
}
<h1 class="page-title">@ViewData["Title"]</h1>
<p class="page-sub">
    @if (creating)
    {
        @L["PDF and Word files are shown as pages. EPUB and text files reflow to fit any screen. Up to {0} MB.", (object)ViewBag.MaxMb]
    }
    else
    {
        @L["Change the details readers see. To replace the file, delete the book and upload it again."]
    }
</p>

<form method="post" enctype="multipart/form-data" class="panel" style="max-width:720px" asp-action="@(creating ? "Create" : "Edit")" asp-route-id="@Model.Id">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    @if (creating)
    {
        <div class="mb-3">
            <label asp-for="File" class="form-label fw-semibold"></label>
            <input asp-for="File" type="file" class="form-control" accept="@ViewBag.Accept" required />
            <span asp-validation-for="File" class="text-danger small"></span>
        </div>
    }
    @{
        // The tab to open first: English, or the first language with an error after a failed save.
        var tabWithError = Enumerable.Range(0, Model.Translations.Count)
            .FirstOrDefault(i => ViewData.ModelState.Any(e => e.Key.StartsWith($"Translations[{i}]") && e.Value!.Errors.Count > 0), -1);
        var englishHasError = new[] { "Title", "Author", "Description" }.Any(k => ViewData.ModelState[k]?.Errors.Count > 0);
        var activeTab = englishHasError || tabWithError < 0 ? -1 : tabWithError;
    }
    <div class="mb-1 d-flex flex-wrap align-items-baseline gap-2">
        <span class="form-label fw-semibold mb-0">@L["Book details"]</span>
        <span class="small text-muted">@L["English is required. Other languages are optional: readers who picked that language see them, and any field left empty shows the English text."]</span>
    </div>
    <ul class="nav nav-tabs mt-2" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == -1 ? "active" : "")" id="tab-en" data-bs-toggle="tab" data-bs-target="#pane-en" type="button" role="tab" aria-controls="pane-en" aria-selected="@(activeTab == -1 ? "true" : "false")">
                English <span class="text-danger">*</span>
            </button>
        </li>
        @for (var i = 0; i < Model.Translations.Count; i++)
        {
            var code = Model.Translations[i].Language;
            var lang = Obrl.Web.Localization.Languages.All.First(l => l.Code == code);
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == i ? "active" : "")" id="tab-@code" data-bs-toggle="tab" data-bs-target="#pane-@code" type="button" role="tab" aria-controls="pane-@code" aria-selected="@(activeTab == i ? "true" : "false")" lang="@code">
                    @lang.NativeName
                    @if (!Model.Translations[i].IsEmpty) { <i class="bi bi-check2 text-success" title="@L["Filled in"]"></i> }
                </button>
            </li>
        }
    </ul>
    <div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
        <div class="tab-pane @(activeTab == -1 ? "active" : "")" id="pane-en" role="tabpanel" aria-labelledby="tab-en" lang="en">
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Author" class="form-label fw-semibold"></label>
                <input asp-for="Author" class="form-control" placeholder="@L["Filled in from the e-book when left empty"]" />
            </div>
            <div>
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
        </div>
        @for (var i = 0; i < Model.Translations.Count; i++)
        {
            var code = Model.Translations[i].Language;
            <div class="tab-pane @(activeTab == i ? "active" : "")" id="pane-@code" role="tabpanel" aria-labelledby="tab-@code">
                <input type="hidden" asp-for="Translations[i].Language" />
                <div class="mb-3">
                    <label asp-for="Translations[i].Title" class="form-label fw-semibold"></label>
                    <input asp-for="Translations[i].Title" class="form-control" lang="@code" placeholder="@L["Empty shows the English title"]" />
                    <span asp-validation-for="Translations[i].Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Translations[i].Author" class="form-label fw-semibold"></label>
                    <input asp-for="Translations[i].Author" class="form-control" lang="@code" placeholder="@L["Empty shows the English author"]" />
                    <span asp-validation-for="Translations[i].Author" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Translations[i].Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Translations[i].Description" class="form-control" rows="4" lang="@code" placeholder="@L["Empty shows the English description"]"></textarea>
                    <span asp-validation-for="Translations[i].Description" class="text-danger small"></span>
                </div>
            </div>
        }
    </div>
    <div class="mb-4">
        <label class="form-label fw-semibold">@L["Categories"]</label>
        @if (Model.AllCategories.Count == 0)
        {
            <div class="alert alert-warning mb-0">@L["There are no categories yet. Ask a moderator to create some first."]</div>
        }
        else
        {
            <div class="border rounded p-2" style="max-height:280px;overflow:auto">
                @foreach (var c in Model.AllCategories)
                {
                    <div class="form-check" style="margin-left:@(c.Depth * 1.25)rem">
                        <input class="form-check-input" type="checkbox" name="CategoryIds" value="@c.Id" id="cat-@c.Id" @(Model.CategoryIds.Contains(c.Id) ? "checked" : "") />
                        <label class="form-check-label" for="cat-@c.Id">@c.Name</label>
                    </div>
                }
            </div>
        }
        <span asp-validation-for="CategoryIds" class="text-danger small"></span>
    </div>
    @{
        var pageBook = Model.Mode == ReaderMode.Page;
        var textBook = Model.Mode == ReaderMode.Text;
        var canPreview = !creating && pageBook && Model.Status == BookStatus.Ready && Model.PageCount > 0;
        const int firstTiles = 24;
        var tiles = canPreview ? Math.Min(Model.PageCount, 600) : 0;
    }
    <div class="mb-4" id="cover">
        <div class="mb-1 d-flex flex-wrap align-items-baseline gap-2">
            <span class="form-label fw-semibold mb-0">@L["Cover"]</span>
            <span class="small text-muted">@L["Use your own image if you have one. Otherwise pick a page from the book. If you do neither, the first page is used."]</span>
        </div>
        <div class="d-flex flex-wrap gap-3 align-items-start mt-2">
            @if (!creating && Model.HasCover)
            {
                <div class="cover cover-current" title="@L["Current cover"]"><img src="/books/@Model.Id/cover" alt="@L["Current cover"]" /></div>
            }
            <div class="flex-grow-1" style="min-width:260px">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" asp-for="CoverSource" value="@CoverSource.Custom" id="cover-custom" />
                    <label class="form-check-label" for="cover-custom">@L["My own cover image"]</label>
                    <input asp-for="CoverImage" type="file" class="form-control form-control-sm mt-1" accept="@Obrl.Web.Services.CoverService.Accept" />
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <div class="cover crop-preview" data-crop-preview="custom" hidden></div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-crop-edit="custom" hidden><i class="bi bi-crop me-1"></i>@L["Crop and adjust"]</button>
                    </div>
                    <div class="small text-muted">
                        @L["JPEG, PNG or WebP, up to {0} MB. After you choose it, crop it to the 2:3 book shape and adjust brightness and contrast.", Obrl.Web.Services.CoverService.MaxImageMegabytes]
                        @if (Model.HasCustomCover) { @L["Your earlier image is kept; choose a file only to replace it."] }
                    </div>
                    <span asp-validation-for="CoverImage" class="text-danger small"></span>
                </div>
                @if (!textBook)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" asp-for="CoverSource" value="@CoverSource.Page" id="cover-page" />
                        <label class="form-check-label" for="cover-page">@L["A page from the book"]</label>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <label for="CoverPage" class="small text-muted">@L["Page"]</label>
                            <input asp-for="CoverPage" type="number" min="1" max="@(Model.PageCount > 0 ? Model.PageCount : null)" class="form-control form-control-sm" style="max-width:110px" />
                            @if (Model.PageCount > 0) { <span class="small text-muted">@L["of {0}", Model.PageCount]</span> }
                            @if (canPreview)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-crop-edit="page" data-page-url="/Uploads/CoverPageImage/@Model.Id"><i class="bi bi-crop me-1"></i>@L["Crop and adjust"]</button>
                            }
                        </div>
                        @if (canPreview)
                        {
                            <input asp-for="PageCoverImage" type="file" accept="image/*" hidden />
                            <input type="hidden" asp-for="ClearPageCrop" value="false" />
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <div class="cover crop-preview" data-crop-preview="page" hidden></div>
                                <button type="button" class="btn btn-sm btn-link p-0" data-crop-undo="page" hidden="@(!Model.HasPageCrop)">@L["Use the page without cropping"]</button>
                            </div>
                            @if (Model.HasPageCrop)
                            {
                                <div class="small text-muted">@L["The current cover is a cropped part of page {0}.", Model.CoverPage ?? 1]</div>
                            }
                        }
                        <div class="small text-muted">
                            @if (creating)
                            {
                                @L["PDF and Word files only. You can also pick the page from pictures once the book is ready."]
                            }
                            else if (!canPreview)
                            {
                                @L["Pictures of the pages appear here once the book is ready."]
                            }
                        </div>
                        <span asp-validation-for="CoverPage" class="text-danger small"></span>
                    </div>
                }
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="CoverSource" value="@CoverSource.Default" id="cover-default" />
                    <label class="form-check-label" for="cover-default">
                        @if (textBook) { @L["The e-book’s own cover, or one made from the title"] }
                        else if (pageBook) { @L["The first page"] }
                        else { @L["The first page (EPUB and text files use the e-book’s own cover)"] }
                    </label>
                </div>
            </div>
        </div>
        @if (tiles > 0)
        {
            <div class="cover-picker mt-3" data-cover-picker>
                @for (var p = 1; p <= tiles; p++)
                {
                    <button type="button" class="cover-tile @(Model.CoverSource == CoverSource.Page && Model.CoverPage == p ? "selected" : "")" data-cover-page="@p" hidden="@(p > firstTiles)" aria-label="@L["Use page {0} as the cover", p]">
                        <img src="/Uploads/CoverPreview/@Model.Id?page=@p" alt="" loading="lazy" />
                        <span>@p</span>
                    </button>
                }
            </div>
            @if (tiles > firstTiles)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-cover-more="@firstTiles">@L["Show more pages"]</button>
            }
        }
    </div>
    <button class="btn btn-primary" type="submit">@(creating ? L["Upload"] : L["Save"])</button>
    <a class="btn btn-link" asp-action="Index">@L["Cancel"]</a>
</form>

<div class="modal fade" id="cover-crop-modal" tabindex="-1" aria-labelledby="cover-crop-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="cover-crop-title">@L["Crop and adjust the cover"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Cancel"]"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">@L["Drag the picture to move it, and drag the frame's corners to change what is kept. The frame keeps the 2:3 book shape."]</p>
                <div class="crop-stage"><img data-crop-image alt="" /></div>
                <div class="d-flex flex-wrap gap-1 mt-2" role="toolbar" aria-label="@L["Crop tools"]">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-crop-action="zoom-in" title="@L["Zoom in"]" aria-label="@L["Zoom in"]"><i class="bi bi-zoom-in"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-crop-action="zoom-out" title="@L["Zoom out"]" aria-label="@L["Zoom out"]"><i class="bi bi-zoom-out"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-crop-action="rotate-left" title="@L["Turn left"]" aria-label="@L["Turn left"]"><i class="bi bi-arrow-counterclockwise"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-crop-action="rotate-right" title="@L["Turn right"]" aria-label="@L["Turn right"]"><i class="bi bi-arrow-clockwise"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-crop-action="flip" title="@L["Mirror"]" aria-label="@L["Mirror"]"><i class="bi bi-symmetry-vertical"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-crop-action="reset"><i class="bi bi-arrow-repeat me-1"></i>@L["Start again"]</button>
                </div>
                <div class="crop-adjust mt-3">
                    <label>@L["Straighten"] <output data-adjust-value="straighten">0°</output>
                        <input type="range" class="form-range" min="-45" max="45" step="1" value="0" data-adjust="straighten" /></label>
                    <label>@L["Brightness"] <output data-adjust-value="brightness">100%</output>
                        <input type="range" class="form-range" min="50" max="150" step="1" value="100" data-adjust="brightness" /></label>
                    <label>@L["Contrast"] <output data-adjust-value="contrast">100%</output>
                        <input type="range" class="form-range" min="50" max="150" step="1" value="100" data-adjust="contrast" /></label>
                    <label>@L["Colour"] <output data-adjust-value="saturation">100%</output>
                        <input type="range" class="form-range" min="0" max="200" step="1" value="100" data-adjust="saturation" /></label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-primary" data-crop-apply><i class="bi bi-check2 me-1"></i>@L["Use this cover"]</button>
            </div>
        </div>
    </div>
</div>

@section Head {
    <link rel="stylesheet" href="~/lib/cropperjs/cropper.min.css" />
}
@section Scripts {
    <script src="~/lib/cropperjs/cropper.min.js"></script>
    <script src="~/js/cover-crop.js" asp-append-version="true"></script>
}
