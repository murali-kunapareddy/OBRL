@model (List<CategoryNode> Nodes, Dictionary<int, int> Counts, Dictionary<int, List<CategoryTranslation>> Translations)
@foreach (var c in Model.Nodes)
{
    <tr>
        <td>
            <span style="padding-left:@(c.Depth * 1.5)rem">
                <i class="bi @(c.Children.Count > 0 ? "bi-folder2-open" : "bi-tag") text-muted me-1"></i>
                <a href="/Library?category=@c.Id">@c.Name</a>
            </span>
            @if (Model.Translations.TryGetValue(c.Id, out var names))
            {
                <span class="small text-muted ms-2">
                    <i class="bi bi-translate me-1" title="@L["Names in other languages"]"></i>
                    @foreach (var lang in Obrl.Web.Localization.Languages.All)
                    {
                        var t = names.FirstOrDefault(x => x.Language == lang.Code);
                        if (t is not null) { <span class="me-2" lang="@lang.Code">@t.Name</span> }
                    }
                </span>
            }
        </td>
        <td class="text-muted small">@(Model.Counts.GetValueOrDefault(c.Id))</td>
        <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-secondary" asp-action="Create" asp-route-parentId="@c.Id" title="@L["Add sub category"]"><i class="bi bi-plus-lg"></i></a>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id" title="@L["Rename or move"]"><i class="bi bi-pencil"></i></a>
            <form class="d-inline" method="post" asp-action="Delete" asp-route-id="@c.Id" data-confirm="@L["Delete the category “{0}”?", c.Name]">
                <button class="btn btn-sm btn-outline-danger" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
            </form>
        </td>
    </tr>
    <partial name="_Rows" model="@((c.Children, Model.Counts, Model.Translations))" />
}
