@model BookDetailsVm
@{
    var b = Model.Book;
    var text = Model.Text;
    ViewData["Title"] = text.Title;
    string FormatLabel() => b.Mode == ReaderMode.Page ? L["{0} pages", b.UnitCount] : L["Reflowable text"];
}
<div class="book-hero">
    <div class="cover">
        @if (b.HasCover)
        {
            <img src="/books/@b.Id/cover" alt="@L["Cover of {0}", text.Title]" />
        }
    </div>
    <div>
        <h1 class="page-title">@text.Title</h1>
        @if (!string.IsNullOrEmpty(text.Author))
        {
            <p class="fs-5 text-muted mb-2">@text.Author</p>
        }
        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge badge-soft">@b.OriginalFormat.ToUpperInvariant()</span>
            @if (b.Status == BookStatus.Ready)
            {
                <span class="badge badge-soft">@FormatLabel()</span>
            }
            else
            {
                <span class="badge text-bg-warning">@L[b.Status.ToString()]</span>
            }
            @if (!b.IsApproved)
            {
                <span class="badge text-bg-warning">@(b.RejectedAt is null ? L["Waiting for review"] : L["Not approved"])</span>
            }
        </div>
        @if (b.RatingCount > 0)
        {
            <div class="mb-3 d-flex align-items-center gap-2">
                <partial name="_Stars" model="b.RatingAverage" />
                <span class="small text-muted">@(b.RatingCount == 1 ? L["{0} from 1 rating", b.RatingAverage.ToString("0.0")] : L["{0} from {1} ratings", b.RatingAverage.ToString("0.0"), b.RatingCount])</span>
            </div>
        }

        @foreach (var trail in Model.CategoryTrails)
        {
            <div class="small mb-1">
                <i class="bi bi-tag text-muted"></i>
                @for (var i = 0; i < trail.Count; i++)
                {
                    <a href="/Library?category=@trail[i].Id">@trail[i].Name</a>
                    @if (i < trail.Count - 1) { <span class="text-muted"> › </span> }
                }
            </div>
        }

        <div class="d-flex flex-wrap gap-2 my-4">
            @if (Model.CanRead)
            {
                var label = Model.Progress is null ? L["Start reading"] : L["Continue ({0}%)", Math.Round(Model.Progress.PercentComplete)];
                <a class="btn btn-primary btn-lg" href="/read/@b.Id"><i class="bi bi-book-half me-1"></i> @label</a>
            }
            @if (b.Status == BookStatus.Ready)
            {
                if (Model.SubscribedToBook && !(Model.OwnBook && Model.Limited))
                {
                    <form method="post" action="/books/@b.Id/unsubscribe">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-primary btn-lg"><i class="bi bi-check2"></i> @L["Subscribed"]</button>
                    </form>
                }
                else if (!Model.CanRead && Model.Limited && Model.SlotsInUse >= Model.MaxBooks)
                {
                    <button class="btn btn-primary btn-lg" disabled><i class="bi bi-plus-lg"></i> @L["Subscribe to read"]</button>
                }
                else if (!Model.CanRead)
                {
                    <form method="post" action="/books/@b.Id/subscribe">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-primary btn-lg"><i class="bi bi-plus-lg"></i> @L["Subscribe to read"]</button>
                    </form>
                }
            }
            @if (Model.CanEdit)
            {
                <a class="btn btn-outline-secondary btn-lg" asp-controller="Uploads" asp-action="Edit" asp-route-id="@b.Id"><i class="bi bi-pencil"></i> @L["Edit details"]</a>
            }
            @if (Model.CanModerate && !b.IsApproved)
            {
                <form method="post" action="/moderation/books/@b.Id/approve">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-success btn-lg"><i class="bi bi-check2-circle"></i> @L["Approve"]</button>
                </form>
            }
            else if (Model.CanModerate)
            {
                <form method="post" action="/moderation/books/@b.Id/reject" data-confirm="@L["Take “{0}” out of the library? The uploader can edit it and resubmit.", text.Title]">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="note" value="@L["Taken down by a Moderator."]" />
                    <button class="btn btn-outline-danger btn-lg"><i class="bi bi-slash-circle"></i> @L["Take down"]</button>
                </form>
            }
        </div>
        @if (b.Status == BookStatus.Ready && Model.Limited)
        {
            <p class="small text-muted mt-n2 mb-4" id="subscription-note">
                @if (Model.OwnBook)
                {
                    <i class="bi bi-person-check me-1"></i>@L["You uploaded this book, so you can read it any time. It does not count towards your books."]
                }
                else if (Model.SubscribedToBook)
                {
                    if (Model.MySubscription!.ExpiresAt is { } until)
                    {
                        <i class="bi bi-hourglass-split me-1"></i>@L["Your subscription ends on {0}. After that, subscribe again to keep reading.", until.ToLocalTime().ToString("D", System.Globalization.CultureInfo.CurrentCulture)]
                    }
                    else
                    {
                        <i class="bi bi-infinity me-1"></i>@L["Your subscription has no end date."]
                    }
                    <span>@L["You are using {0} of your {1} books.", Model.SlotsInUse, Model.MaxBooks]</span>
                }
                else if (!Model.CanRead)
                {
                    if (Model.SubscriptionEnded)
                    {
                        <i class="bi bi-hourglass-bottom me-1"></i>@L["Your subscription ended on {0}.", Model.MySubscription!.ExpiresAt!.Value.ToLocalTime().ToString("D", System.Globalization.CultureInfo.CurrentCulture)]
                    }
                    if (Model.SlotsInUse >= Model.MaxBooks)
                    {
                        <span>@H["You already have {0} books, the most you can have at a time. <a href=\"/Library?mine=true\">Unsubscribe from one</a> to read this book.", Model.MaxBooks]</span>
                    }
                    else
                    {
                        <span>@L["You can have up to {0} books at a time; you are using {1}.", Model.MaxBooks, Model.SlotsInUse]</span>
                        if (Model.LoanDays > 0)
                        {
                            <span>@L["Each subscription lasts {0} days.", Model.LoanDays]</span>
                        }
                    }
                }
            </p>
        }

        @if (!b.IsApproved && b.ReviewNote is not null && Model.CanEdit)
        {
            <div class="alert alert-warning"><strong>@L["Moderator note:"]</strong> @b.ReviewNote</div>
        }

        @if (Model.CanEdit)
        {
            var entered = Obrl.Web.Localization.Languages.All
                .Where(l => l.Code == Obrl.Web.Localization.Languages.Default || Model.TranslatedLanguages.Contains(l.Code))
                .Select(l => l.NativeName);
            <p class="small text-muted"><i class="bi bi-translate me-1"></i>@L["Details entered in: {0}", string.Join(", ", entered)]</p>
        }

        @if (!string.IsNullOrEmpty(text.Description))
        {
            <h2 class="h5">@L["About this book"]</h2>
            <p style="white-space:pre-line">@text.Description</p>
        }

        @if (Model.Bookmarks.Count > 0 && Model.CanRead)
        {
            <h2 class="h5 mt-4">@L["Your bookmarks"]</h2>
            <div class="list-group" style="max-width:520px">
                @foreach (var m in Model.Bookmarks)
                {
                    <a class="list-group-item list-group-item-action" href="/read/@b.Id?at=@m.Position">
                        <i class="bi bi-bookmark-fill me-2"></i>
                        @(b.Mode == ReaderMode.Page ? L["Page {0}", m.Position + 1] : L["Section {0}", m.Position + 1])
                        @if (m.Note is not null) { <span class="text-muted">· @m.Note</span> }
                    </a>
                }
            </div>
        }
    </div>
</div>

@if (b.Status == BookStatus.Ready && b.IsApproved)
{
    <section class="book-social">
        @if (Model.CanRead)
        {
            <div class="panel p-3 mb-4" id="rating">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <strong>@(Model.MyRating is null ? L["Rate this book"] : L["Your rating"])</strong>
                    <form method="post" action="/books/@b.Id/rate" class="star-input" aria-label="@L["Rate from 1 to 5 stars"]">
                        @Html.AntiForgeryToken()
                        @for (var i = 5; i >= 1; i--)
                        {
                            <button type="submit" name="stars" value="@i" class="@(Model.MyRating >= i ? "on" : "")" title="@(i == 1 ? L["1 star"] : L["{0} stars", i])" aria-label="@(i == 1 ? L["1 star"] : L["{0} stars", i])"><i class="bi bi-star-fill"></i></button>
                        }
                    </form>
                    @if (Model.MyRating is not null)
                    {
                        <form method="post" action="/books/@b.Id/rate">
                            @Html.AntiForgeryToken()
                            <button type="submit" name="stars" value="0" class="btn btn-link btn-sm p-0">@L["Remove my rating"]</button>
                        </form>
                    }
                </div>
            </div>
        }

        <h2 class="h5" id="comments">@L["Comments"] <span class="text-muted fw-normal">@Model.Comments.Sum(c => 1 + c.Replies.Count)</span></h2>
        @if (Model.CanRead)
        {
            <form method="post" action="/books/@b.Id/comments" class="comment-form mb-4">
                @Html.AntiForgeryToken()
                <textarea name="body" class="form-control mb-2" rows="3" maxlength="4000" placeholder="@L["Share what you thought of this book"]" aria-label="@L["Write a comment"]" required></textarea>
                <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-send me-1"></i> @L["Post comment"]</button>
            </form>
        }
        else
        {
            <p class="text-muted small">@L["Subscribe to this book to rate it and join the discussion."]</p>
        }

        @if (Model.Comments.Count == 0)
        {
            <p class="text-muted">@L["No comments yet."]</p>
        }
        <div class="comment-list">
            @foreach (var c in Model.Comments)
            {
                <partial name="_Comment" model="@((c, b.Id, Model.CanRead, Model.CanModerate, true))" />
            }
        </div>
    </section>
}
