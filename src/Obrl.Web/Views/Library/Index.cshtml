@model LibraryVm
@{
    ViewData["Title"] = Model.Current?.Name ?? L["Library"].Value;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var covered = Model.Current is not null && Model.IsCovered(Model.Current);
    var direct = Model.Current is not null && Model.SubscribedIds.Contains(Model.Current.Id);
}
<div class="library">
    <aside>
        <div class="panel p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <strong>@L["Categories"]</strong>
                <a class="small" href="/Library">@L["All books"]</a>
            </div>
            @if (Model.Roots.Count == 0)
            {
                <p class="small text-muted mb-0">@L["No categories yet."]</p>
            }
            else
            {
                <div class="cat-tree"><partial name="_CategoryTree" model="@((Model.Roots, Model))" /></div>
            }
        </div>
    </aside>

    <section>
        @if (Model.Breadcrumb.Count > 0)
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-2">
                    <li class="breadcrumb-item"><a href="/Library">@L["Library"]</a></li>
                    @foreach (var c in Model.Breadcrumb)
                    {
                        if (c.Id == Model.Current!.Id)
                        {
                            <li class="breadcrumb-item active" aria-current="page">@c.Name</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item"><a href="/Library?category=@c.Id">@c.Name</a></li>
                        }
                    }
                </ol>
            </nav>
        }

        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
            <div>
                <h1 class="page-title">
                    @if (Model.Query is not null)
                    {
                        @L["Results for “{0}”", Model.Query]
                    }
                    else if (Model.MySubscriptionsOnly)
                    {
                        @L["My subscriptions"]
                    }
                    else
                    {
                        @(Model.Current?.Name ?? L["All books"])
                    }
                </h1>
                @if (Model.Current?.Description is string d)
                {
                    <p class="text-muted mb-0">@d</p>
                }
            </div>
            @if (Model.Current is not null)
            {
                if (direct)
                {
                    <form method="post" asp-action="Unsubscribe" asp-route-id="@Model.Current.Id" asp-route-returnUrl="@returnUrl">
                        <button class="btn btn-outline-primary"><i class="bi bi-check2"></i> @L["Following"]</button>
                    </form>
                }
                else if (covered)
                {
                    <span class="badge badge-soft p-2">@L["Included in a category you follow"]</span>
                }
                else
                {
                    <form method="post" asp-action="Subscribe" asp-route-id="@Model.Current.Id" asp-route-returnUrl="@returnUrl">
                        <button class="btn btn-primary"><i class="bi bi-plus-lg"></i> @L["Follow"]</button>
                    </form>
                }
            }
        </div>
        @if (Model.Current is not null)
        {
            <p class="small text-muted">@L["Following shows new books from this category and every sub category below it on your dashboard. To read a book, open it and subscribe to it."]</p>
        }
        @if (Model.MySubscriptionsOnly && Model.Limited)
        {
            <p class="small text-muted" id="book-slots">
                <i class="bi bi-collection me-1"></i>@L["You are using {0} of your {1} books. To free one, open the book and press Subscribed to unsubscribe.", Model.SlotsInUse, Model.MaxBooks]
            </p>
        }

        @if (Model.Books.Count == 0)
        {
            <div class="empty-shelf">@L["No books here yet."]</div>
        }
        else
        {
            <div class="book-grid">
                @foreach (var b in Model.Books)
                {
                    <partial name="_BookCard" model="b" />
                }
            </div>
            <div class="d-flex gap-2 mt-4">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-outline-secondary" href="?category=@Model.Current?.Id&q=@Model.Query&mine=@Model.MySubscriptionsOnly&page=@(Model.Page - 1)">@L["Previous"]</a>
                }
                @if (Model.HasMore)
                {
                    <a class="btn btn-outline-secondary" href="?category=@Model.Current?.Id&q=@Model.Query&mine=@Model.MySubscriptionsOnly&page=@(Model.Page + 1)">@L["Next"]</a>
                }
            </div>
        }
    </section>
</div>
