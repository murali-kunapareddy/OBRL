@model LibraryVm
@{
    ViewData["Title"] = Model.Current?.Name ?? "Library";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var covered = Model.Current is not null && Model.IsCovered(Model.Current);
    var direct = Model.Current is not null && Model.SubscribedIds.Contains(Model.Current.Id);
}
<div class="library">
    <aside>
        <div class="panel p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <strong>Categories</strong>
                <a class="small" href="/Library">All books</a>
            </div>
            @if (Model.Roots.Count == 0)
            {
                <p class="small text-muted mb-0">No categories yet.</p>
            }
            else
            {
                <div class="cat-tree"><partial name="_CategoryTree" model="@((Model.Roots, Model))" /></div>
            }
        </div>
    </aside>

    <section>
        @if (Model.Breadcrumb.Count > 0)
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-2">
                    <li class="breadcrumb-item"><a href="/Library">Library</a></li>
                    @foreach (var c in Model.Breadcrumb)
                    {
                        if (c.Id == Model.Current!.Id)
                        {
                            <li class="breadcrumb-item active" aria-current="page">@c.Name</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item"><a href="/Library?category=@c.Id">@c.Name</a></li>
                        }
                    }
                </ol>
            </nav>
        }

        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
            <div>
                <h1 class="page-title">
                    @if (Model.Query is not null)
                    {
                        <text>Results for “@Model.Query”</text>
                    }
                    else if (Model.MySubscriptionsOnly)
                    {
                        <text>My subscriptions</text>
                    }
                    else
                    {
                        @(Model.Current?.Name ?? "All books")
                    }
                </h1>
                @if (Model.Current?.Description is string d)
                {
                    <p class="text-muted mb-0">@d</p>
                }
            </div>
            @if (Model.Current is not null)
            {
                if (direct)
                {
                    <form method="post" asp-action="Unsubscribe" asp-route-id="@Model.Current.Id" asp-route-returnUrl="@returnUrl">
                        <button class="btn btn-outline-primary"><i class="bi bi-check2"></i> Subscribed</button>
                    </form>
                }
                else if (covered)
                {
                    <span class="badge badge-soft p-2">Included in a parent subscription</span>
                }
                else
                {
                    <form method="post" asp-action="Subscribe" asp-route-id="@Model.Current.Id" asp-route-returnUrl="@returnUrl">
                        <button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Subscribe</button>
                    </form>
                }
            }
        </div>
        @if (Model.Current is not null)
        {
            <p class="small text-muted">Subscribing includes every sub category below this one. It is free.</p>
        }

        @if (Model.Books.Count == 0)
        {
            <div class="empty-shelf">No books here yet.</div>
        }
        else
        {
            <div class="book-grid">
                @foreach (var b in Model.Books)
                {
                    <partial name="_BookCard" model="b" />
                }
            </div>
            <div class="d-flex gap-2 mt-4">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-outline-secondary" href="?category=@Model.Current?.Id&q=@Model.Query&mine=@Model.MySubscriptionsOnly&page=@(Model.Page - 1)">Previous</a>
                }
                @if (Model.HasMore)
                {
                    <a class="btn btn-outline-secondary" href="?category=@Model.Current?.Id&q=@Model.Query&mine=@Model.MySubscriptionsOnly&page=@(Model.Page + 1)">Next</a>
                }
            </div>
        }
    </section>
</div>
