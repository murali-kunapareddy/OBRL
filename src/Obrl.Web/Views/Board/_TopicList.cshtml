@model List<BoardTopicRow>
<ul class="topic-list">
    @foreach (var t in Model)
    {
        <li class="@(t.IsHidden ? "is-hidden" : "")">
            <a href="/board/@t.Id" class="topic-link">
                <span class="topic-title">
                    @if (t.IsPinned) { <i class="bi bi-pin-angle-fill text-primary" title="@L["Pinned"]"></i> }
                    @if (t.IsLocked) { <i class="bi bi-lock-fill text-muted" title="@L["Locked"]"></i> }
                    @if (t.IsHidden) { <span class="badge text-bg-secondary">@L["Hidden"]</span> }
                    @t.Title
                </span>
                <span class="topic-meta">
                    @t.AuthorName · <time datetime="@t.CreatedAt.ToString("o")">@t.CreatedAt.ToString("d MMM yyyy")</time>
                </span>
            </a>
            <span class="topic-stats">
                <span title="@L["Replies"]"><i class="bi bi-chat"></i> @t.Replies</span>
                <span class="d-none d-sm-inline text-muted" title="@L["Last activity"]">@t.LastActivityAt.ToString("d MMM HH:mm")</span>
            </span>
        </li>
    }
</ul>
