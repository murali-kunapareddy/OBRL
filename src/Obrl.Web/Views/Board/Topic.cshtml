@model BoardTopicVm
@{
    var t = Model.Topic;
    ViewData["Title"] = t.Title;
}
<nav class="small mb-2"><a href="/board"><i class="bi bi-arrow-left"></i> @L["Message board"]</a></nav>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <h1 class="page-title mb-0">
        @if (t.IsPinned) { <i class="bi bi-pin-angle-fill text-primary" title="@L["Pinned"]"></i> }
        @t.Title
    </h1>
    @if (Model.CanModerate)
    {
        <div class="d-flex flex-wrap gap-1">
            <partial name="_ModerateButton" model="@((t.Id, t.IsPinned ? "unpin" : "pin", t.IsPinned ? L["Unpin"].Value : L["Pin"].Value, "bi-pin-angle"))" />
            <partial name="_ModerateButton" model="@((t.Id, t.IsLocked ? "unlock" : "lock", t.IsLocked ? L["Unlock"].Value : L["Lock"].Value, t.IsLocked ? "bi-unlock" : "bi-lock"))" />
            <partial name="_ModerateButton" model="@((t.Id, t.IsHidden ? "unhide" : "hide", t.IsHidden ? L["Show"].Value : L["Hide"].Value, t.IsHidden ? "bi-eye" : "bi-eye-slash"))" />
        </div>
    }
</div>
@if (t.IsHidden)
{
    <div class="alert alert-secondary"><i class="bi bi-eye-slash me-1"></i> @L["This topic is hidden from members."]</div>
}
@if (t.IsLocked)
{
    <div class="alert alert-secondary"><i class="bi bi-lock me-1"></i> @L["This topic is locked. No new replies."]</div>
}

<div class="post-list">
    <partial name="_Post" model="@((Model.Opening, Model.CanModerate, true))" />
    @foreach (var r in Model.Replies)
    {
        <partial name="_Post" model="@((r, Model.CanModerate, false))" />
    }
</div>

@if (Model.CanReply)
{
    <form id="reply" method="post" action="/board/@t.Id/reply" class="panel p-3 mt-3">
        @Html.AntiForgeryToken()
        <label class="form-label fw-semibold" for="reply-body">@L["Reply"]</label>
        <textarea id="reply-body" name="body" class="form-control mb-2" rows="4" maxlength="8000" required></textarea>
        <button class="btn btn-primary" type="submit"><i class="bi bi-reply me-1"></i> @L["Post reply"]</button>
    </form>
}
