@model BookListsVm
@{
    ViewData["Title"] = L["Book lists"].Value;
}
<h1 class="page-title">@L["Book lists"]</h1>
<p class="page-sub">@L["The languages and publishers uploaders choose from when they add or edit a book."]</p>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="panel p-4">
            <h2 class="h5">@L["Languages"]</h2>
            <p class="text-muted small">@L["Uploaders pick the book's language from this list only. Lower numbers come first. A language used by books cannot be deleted."]</p>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>@L["Name"]</th><th style="width:90px">@L["Order"]</th><th class="text-end">@L["Books"]</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var l in Model.Languages)
                    {
                        <tr>
                            <td colspan="2">
                                <form method="post" asp-action="SaveLanguage" class="d-flex gap-1">
                                    <input type="hidden" name="id" value="@l.Id" />
                                    <input name="name" value="@l.Name" class="form-control form-control-sm" maxlength="60" required aria-label="@L["Name"]" />
                                    <input name="sortOrder" value="@l.SortOrder" type="number" class="form-control form-control-sm" style="width:80px" aria-label="@L["Order"]" />
                                    <button class="btn btn-sm btn-outline-secondary">@L["Save"]</button>
                                </form>
                            </td>
                            <td class="text-end small text-muted">@l.Books</td>
                            <td class="text-end">
                                @if (l.Books == 0)
                                {
                                    <form method="post" asp-action="DeleteLanguage" data-confirm="@L["Delete {0}?", l.Name]">
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <button class="btn btn-sm btn-link text-danger" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <form method="post" asp-action="SaveLanguage" class="d-flex gap-1">
                <input name="name" class="form-control form-control-sm" maxlength="60" required placeholder="@L["New language"]" aria-label="@L["New language"]" />
                <input type="hidden" name="sortOrder" value="0" />
                <button class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg me-1"></i>@L["Add"]</button>
            </form>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel p-4">
            <h2 class="h5">@L["Publishers"]</h2>
            <p class="text-muted small">@L["Uploaders pick a publisher from this list or type a new one, which is added here. Fix spelling here; renaming one to another's name merges the two."]</p>
            @if (Model.Publishers.Count == 0)
            {
                <p class="text-muted small mb-0">@L["No publishers yet."]</p>
            }
            else
            {
                <div class="table-responsive" style="max-height:600px;overflow:auto">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>@L["Name"]</th><th class="text-end">@L["Books"]</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.Publishers)
                        {
                            <tr>
                                <td>
                                    <form method="post" asp-action="SavePublisher" class="d-flex gap-1">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input name="name" value="@p.Name" class="form-control form-control-sm" maxlength="200" required aria-label="@L["Name"]" />
                                        <button class="btn btn-sm btn-outline-secondary">@L["Save"]</button>
                                    </form>
                                </td>
                                <td class="text-end small text-muted">@p.Books</td>
                                <td class="text-end">
                                    @if (p.Books == 0)
                                    {
                                        <form method="post" asp-action="DeletePublisher" data-confirm="@L["Delete {0}?", p.Name]">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button class="btn btn-sm btn-link text-danger" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
