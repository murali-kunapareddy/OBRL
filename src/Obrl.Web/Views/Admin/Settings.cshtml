@model SettingsVm
@{
    ViewData["Title"] = L["Settings"].Value;
}
<h1 class="page-title">@L["Settings"]</h1>
<p class="page-sub">@L["Library-wide settings. Changes apply straight away to everyone."]</p>

<form method="post" asp-action="Settings" class="panel p-4" style="max-width:640px">
    <h2 class="h5">@L["Sign out after inactivity"]</h2>
    <p class="text-muted small">
        @L["Members are signed out when nothing has happened for this long: no scrolling, typing, clicking or page turns. A notice one minute before lets them stay signed in. Shorter is safer on shared computers; longer suits people who read one page for a long time."]
    </p>
    <div class="d-flex flex-wrap gap-2 mb-3" role="radiogroup" aria-label="@L["Minutes"]">
        @foreach (var m in Obrl.Web.Security.IdleTimeout.Choices)
        {
            <input type="radio" class="btn-check" name="idleMinutes" id="idle-@m" value="@m" checked="@(m == Model.IdleMinutes)" />
            <label class="btn btn-outline-primary" for="idle-@m">@L["{0} minutes", m]</label>
        }
    </div>
    <button type="submit" class="btn btn-primary">@L["Save"]</button>
</form>

<form method="post" asp-action="Loans" class="panel p-4 mt-4" style="max-width:640px" id="loans">
    <h2 class="h5">@L["Book subscriptions"]</h2>
    <p class="text-muted small">
        @L["Users and Contributors can be subscribed to up to {0} books at a time, and each subscription lasts the time below. When it ends, the book goes back to locked and the member can subscribe again. Contributors read the books they uploaded with no subscription and no end date. Moderators and Admins read everything.", Model.MaxBooks]
        @L["A new period applies to new subscriptions only."]
    </p>
    <div class="d-flex flex-wrap gap-2 mb-3" role="radiogroup" aria-label="@L["Subscription length"]">
        @foreach (var d in Obrl.Web.Services.Lending.LoanDayChoices)
        {
            <input type="radio" class="btn-check" name="loanDays" id="loan-@d" value="@d" checked="@(d == Model.LoanDays)" />
            <label class="btn btn-outline-primary" for="loan-@d">@(d == 0 ? L["No end date"] : L["{0} days", d])</label>
        }
    </div>
    <button type="submit" class="btn btn-primary">@L["Save"]</button>
</form>

<form method="post" asp-action="Email" class="panel p-4 mt-4" style="max-width:640px" id="email">
    <h2 class="h5">@L["Email"]</h2>
    @if (Model.Email.Configured)
    {
        <p class="text-muted small">@L["Mail server {0}, sending as {1}.", Model.Email.Server!, Model.Email.From!]</p>
    }
    else
    {
        <div class="alert alert-warning small">
            @L["Email is not set up on the server, so no email is sent. Set the Obrl:Email settings (mail server, sender address, user name and password) on the server and restart OBRL. The deployment guide explains how."]
        </div>
    }
    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" name="notifyUploads" value="true" id="notify-uploads" checked="@Model.Email.NotifyUploads" />
        <label class="form-check-label" for="notify-uploads">@L["Email Moderators and Admins when a book is uploaded"]</label>
    </div>
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" name="welcomeUsers" value="true" id="welcome-users" checked="@Model.Email.WelcomeUsers" />
        <label class="form-check-label" for="welcome-users">@L["Email new members their temporary password and the sign-in link"]</label>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">@L["Save"]</button>
        @if (Model.Email.Configured)
        {
            <button type="submit" class="btn btn-outline-secondary" asp-action="TestEmail" formnovalidate><i class="bi bi-envelope me-1"></i>@L["Send me a test email"]</button>
        }
    </div>
</form>
