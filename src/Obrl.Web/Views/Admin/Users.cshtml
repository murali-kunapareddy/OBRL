@model List<UserRow>
@inject Obrl.Web.Services.Email.Notifications Notify
@{
    ViewData["Title"] = L["Users"].Value;
    var canEmail = Notify.CanWelcomeUsers;
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="page-title">@L["Users"]</h1>
        <p class="page-sub">@L["Accounts are created here. Every user sets up two-factor sign-in at first login."]</p>
    </div>
    <a class="btn btn-primary" asp-action="CreateUser"><i class="bi bi-person-plus me-1"></i> @L["Add user"]</a>
</div>
<form method="get" class="mb-3" style="max-width:360px">
    <input class="form-control" name="q" value="@ViewBag.Query" placeholder="@L["Search by email or name"]" />
</form>
<div class="panel p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>@L["User"]</th><th>@L["Role"]</th><th>@L["Sign-in"]</th><th>@L["Last sign-in"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@u.DisplayName</div>
                        <div class="small text-muted">@u.Email</div>
                        @if (u.LockedOut) { <span class="badge text-bg-danger">@L["Locked"]</span> }
                    </td>
                    <td>
                        <form method="post" asp-action="SetRole" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@u.Id" />
                            <select name="role" class="form-select form-select-sm" style="width:auto">
                                @foreach (var r in Roles.All)
                                {
                                    <option value="@r" selected="@(r == u.Role)">@L[r]</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-secondary">@L["Set"]</button>
                        </form>
                    </td>
                    <td class="text-nowrap">
                        @if (u.TwoFactor) { <i class="bi bi-shield-check text-success" title="@L["Authenticator app"]"></i> }
                        @if (u.Passkeys > 0) { <span class="small" title="@L["Passkeys"]"><i class="bi bi-key text-success"></i> @u.Passkeys</span> }
                        @if (!u.TwoFactor && u.Passkeys == 0) { <span class="small text-muted">@L["not yet"]</span> }
                    </td>
                    <td class="small text-muted">@(u.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? L["never"])</td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">@L["Actions"]</button>
                            <div class="dropdown-menu dropdown-menu-end p-2" style="min-width:280px">
                                <form method="post" asp-action="ResetPassword" class="mb-2">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <label class="small fw-semibold">@L["New temporary password"]</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" name="password" class="form-control" minlength="12" required="@(!canEmail)" autocomplete="off" placeholder="@(canEmail ? L["Empty: make one up"] : null)" />
                                        <button class="btn btn-outline-secondary">@L["Set"]</button>
                                    </div>
                                    @if (canEmail)
                                    {
                                        <div class="form-check small mt-1">
                                            <input class="form-check-input" type="checkbox" name="sendEmail" value="true" id="mail-@u.Id" checked />
                                            <label class="form-check-label" for="mail-@u.Id">@L["Email it to them"]</label>
                                        </div>
                                    }
                                </form>
                                <form method="post" asp-action="ResetTwoFactor" data-confirm="@L["Reset the authenticator app and remove all passkeys for {0}?", u.Email]">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="dropdown-item">@L["Reset authenticator and passkeys"]</button>
                                </form>
                                <form method="post" asp-action="SignOutUser">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="dropdown-item">@L["Sign out now"]</button>
                                </form>
                                <form method="post" asp-action="Lock" data-confirm="@(u.LockedOut ? L["Unlock {0}?", u.Email] : L["Lock {0}?", u.Email])">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <input type="hidden" name="locked" value="@(u.LockedOut ? "false" : "true")" />
                                    <button class="dropdown-item @(u.LockedOut ? "" : "text-danger")">@(u.LockedOut ? L["Unlock account"] : L["Lock account"])</button>
                                </form>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
