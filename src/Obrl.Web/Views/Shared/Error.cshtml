@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="panel" style="max-width:560px">
    <h1 class="page-title">Something went wrong</h1>
    <p class="text-muted">The page could not be shown. Try again, or go back to the dashboard.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-3">Reference for the administrator: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" href="/">Back to dashboard</a>
</div>
