@model BookCard
<a class="book-card" href="/books/@Model.Id" title="@Model.Title">
    <div class="cover">
        @if (Model.HasCover)
        {
            <img src="/books/@Model.Id/cover" alt="" loading="lazy" />
        }
        @if (!Model.CanRead)
        {
            <span class="lock" title="Subscribe to read"><i class="bi bi-lock-fill"></i></span>
        }
        @if (Model.Percent is double p)
        {
            <div class="progress-line"><span style="width:@(Math.Round(p))%"></span></div>
        }
    </div>
    <div class="book-title">@Model.Title</div>
    @if (!string.IsNullOrEmpty(Model.Author))
    {
        <div class="book-author">@Model.Author</div>
    }
    @if (Model.Rating is not null || Model.Note is not null)
    {
        <div class="book-meta">
            @if (Model.Rating is double stars)
            {
                <partial name="_Stars" model="stars" />
            }
            @if (Model.Note is not null)
            {
                <span>@Model.Note</span>
            }
        </div>
    }
</a>
